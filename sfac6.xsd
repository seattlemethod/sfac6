  <element id='sfac6_ComprehensiveIncomeStatementLineItems' name='ComprehensiveIncomeStatementLineItems' type='xbrli:stringItemType' substitutionGroup='xbrli:item' xbrli:periodType='duration'  abstract='true' nillable='true' />
