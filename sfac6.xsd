  <element id='sfac6_Expenses' name='Expenses' type='xbrli:monetaryItemType' substitutionGroup='xbrli:item' xbrli:periodType='duration' xbrli:balance='debit'  nillable='true' />
  <element id='sfac6_Gains' name='Gains' type='xbrli:monetaryItemType' substitutionGroup='xbrli:item' xbrli:periodType='duration' xbrli:balance='credit'  nillable='true' />
